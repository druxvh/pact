# Supabase (accounts + cloud data)
#
# Project URL and the PUBLISHABLE key (Dashboard → Project Settings → API Keys). The publishable key is meant to be
# public; never put the secret / service_role key here. Without these, pact runs as a guest-only app.
# Also: Authentication → URL Configuration → add the extension's redirect URL to "Redirect URLs"
# (Settings → sign-in screen shows it), and enable the GitHub and Google providers.
WXT_SUPABASE_URL=
WXT_SUPABASE_PUBLISHABLE_KEY=

# Email sign-in (one-time code). Off by default: it needs custom SMTP in Supabase (Authentication → Emails → SMTP Settings)
# so the "Magic Link"/"Confirm signup" templates can be edited to show {{ .Token }}. Turn it on once that's done.
WXT_EMAIL_SIGN_IN=false
